<?xml version="1.0" encoding="utf-8"?>
<metadata>
    <layout title="Vivere il Comune (Modello PA)" option="Vivere il Comune (Modello PA)">
        <help key="Articles:_Category_Blog" />
        <message>
            <![CDATA[Layout dedicato alla pagina "Vivere il Comune" (Designers Italia). Mostra articoli in evidenza da due categorie configurabili (Events e Luoghi) con i data-element richiesti dall'App Valutazione Modelli: live-category-link, live-button-events, live-button-locations.]]>
        </message>
    </layout>

    <fields name="request">
        <fieldset name="request">
            <field
                name="id"
                type="category"
                extension="com_content"
                label="JCATEGORY"
                required="true"
            />
        </fieldset>
    </fields>

    <fields name="params">

        <fieldset name="vivere_params" label="Opzioni layout Vivere il Comune">

            <field
                name="vivere_cat_eventi"
                type="category"
                extension="com_content"
                label="Categoria «Eventi»"
                description="Seleziona la categoria Joomla degli eventi. Verranno mostrati gli articoli marcati come «in evidenza» (featured) di questa categoria."
                default=""
                required="false"
            />

            <field
                name="vivere_cat_luoghi"
                type="category"
                extension="com_content"
                label="Categoria «Luoghi»"
                description="Seleziona la categoria Joomla dei luoghi. Verranno mostrati gli articoli marcati come «in evidenza» (featured) di questa categoria."
                default=""
                required="false"
            />

            <field
                name="vivere_count"
                type="number"
                default="3"
                min="1"
                max="12"
                label="Numero di card per sezione"
                description="Quante card mostrare nella sezione «In evidenza» per eventi e luoghi (default: 3)."
            />

        </fieldset>

        <fieldset name="basic" label="JGLOBAL_CATEGORY_OPTIONS">

            <field
                name="show_category_title"
                type="list"
                label="JGLOBAL_SHOW_CATEGORY_TITLE"
                useglobal="true"
                class="form-select-color-state"
                validate="options"
            >
                <option value="0">JHIDE</option>
                <option value="1">JSHOW</option>
            </field>

            <field
                name="show_description"
                type="list"
                label="JGLOBAL_SHOW_CATEGORY_DESCRIPTION_LABEL"
