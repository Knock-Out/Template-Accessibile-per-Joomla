<?xml version="1.0" encoding="utf-8"?>
<metadata>
    <layout title="Amministrazione (Modello PA)" option="Amministrazione (Modello PA)">
        <help key="Articles:_Category_Blog" />
        <message>
            <![CDATA[Layout dedicato alla categoria Amministrazione del Comune (Designers Italia). Applica data-element="management-category-link" sui link alle sottocategorie di secondo livello, richiesto dall'App Valutazione Modelli per il criterio C.SI.1.7.]]>
        </message>
    </layout>

    <fields name="request">
        <fieldset name="request">
            <field
                name="id"
                type="category"
                extension="com_content"
                label="JCATEGORY"
                required="true"
            />
        </fieldset>
    </fields>

    <fields name="params">

        <fieldset name="amministrazione_params" label="Opzioni layout Amministrazione">
            <field
                name="show_featured_amm"
                type="radio"
                default="1"
                label="Mostra sezione «In evidenza»"
                description="Se attivo, mostra i primi N articoli in evidenza su sfondo grigio nella parte alta della pagina (solo a pagina 1)."
                class="btn-group btn-group-yesno">
                <option value="1">JYES</option>
                <option value="0">JNO</option>
            </field>
            <field
                name="featured_amm_count"
                type="number"
                default="3"
                min="1"
                max="12"
                label="Numero articoli in evidenza"
                description="Quanti articoli in evidenza mostrare. Visibile solo se la sezione è attiva."
            />
        </fieldset>

